{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^prebuild", "^build"]
    },
    "typings": {
      "outputs": ["dist/**"],
      "dependsOn": ["^typings"]
    },
    "prebuild": {
      "dependsOn": ["^prebuild"]
    },
    "test:ci": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false
    }
  }
}
