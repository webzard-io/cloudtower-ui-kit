{
  "name": "@cloudtower/sparrow",
  "version": "0.1.2",
  "main": "dist/umd/index.js",
  "module": "./dist/esm/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "rollup --config rollup.config.js --bundleConfigAsCjs",
    "postbuild": "cp -r src/images dist/images",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "pregenerate": "rm -rf src/generated",
    "generate": "graphql-codegen-esm --config src/codegen/config/codegen-main.ts",
    "typings": "tsc --emitDeclarationOnly --skipLibCheck -p tsconfig.build.json"
  },
  "devDependencies": {
    "@cloudtower/claw": "^0.1.1",
    "@linaria/rollup": "^4.1.5",
    "@rollup/plugin-commonjs": "^23.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^9.0.1",
    "@smartx/final-form": "^4.19.1-rc2",
    "@smartx/react-final-form": "^6.4.0-rc4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.1.5",
    "@tower/utils": "^1.9.3",
    "@types/history": "^4",
    "@types/react": "^17.0.50",
    "@types/react-is": "^17.0.3",
    "@vitejs/plugin-react": "^2.1.0",
    "@vitest/coverage-c8": "^0.24.1",
    "esbuild": "^0.15.11",
    "jsdom": "^20.0.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-is": "^18.2.0",
    "rollup": "^3.2.2",
    "rollup-plugin-esbuild": "^4.10.1",
    "rollup-plugin-polyfill-node": "^0.10.2",
    "rollup-plugin-scss": "^3.0.0",
    "rollup-plugin-visualizer": "^5.8.2",
    "sass": "^1.55.0",
    "vite": "^3.1.7",
    "vitest": "^0.24.1"
  },
  "dependencies": {
    "@ant-design/icons": "^4.7.0",
    "@linaria/core": "^4.2.1",
    "@linaria/react": "^4.2.1",
    "@smartx/final-form": "^4.19.1-rc2",
    "@smartx/react-final-form": "^6.4.0-rc4",
    "@smartx/react-final-form-arrays": "^3.1.1-rc5",
    "@tower/utils": "^1.9.3",
    "antd": "4.5",
    "apollo-boost": "^0.4.9",
    "history": "^4",
    "i18next": "^22.0.2",
    "react-i18next": "^12.0.0",
    "react-redux": "^8.0.4",
    "redux": "^4.2.0"
  }
}
