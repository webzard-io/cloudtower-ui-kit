{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@cloudtower/eagle": ["./src/index.ts"],
      "@cloudtower/parrot": ["../parrot/src/index.ts"]
    }
  },
  "include": ["src", "images.d.ts"],
  "exclude": ["node_modules"]
}
