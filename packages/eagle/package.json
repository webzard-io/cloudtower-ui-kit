{
  "name": "@cloudtower/eagle",
  "version": "0.6.11",
  "main": "dist/umd/index.js",
  "module": "./dist/esm/index.js",
  "types": "typings/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/umd/index.js",
      "types": "./typings/src/index.d.ts"
    },
    "./generated/forms-types": {
      "import": "./dist/esm/generated/forms-types.js",
      "require": "./dist/umd/generated/forms-types.js",
      "types": "./typings/src/generated/forms-types.d.ts"
    },
    "./generated/forms": {
      "import": "./dist/esm/generated/forms.js",
      "require": "./dist/umd/generated/forms.js",
      "types": "./typings/src/generated/forms.d.ts"
    },
    "./generated/forms2": {
      "import": "./dist/esm/generated/forms2.js",
      "require": "./dist/umd/generated/forms2.js",
      "types": "./typings/src/generated/forms2.d.ts"
    },
    "./generated/global-search": {
      "import": "./dist/esm/generated/global-search.js",
      "require": "./dist/umd/generated/global-search.js",
      "types": "./typings/src/generated/global-search.d.ts"
    },
    "./generated/react-hooks": {
      "import": "./dist/esm/generated/react-hooks.js",
      "require": "./dist/umd/generated/react-hooks.js",
      "types": "./typings/src/generated/react-hooks.d.ts"
    },
    "./generated/tables": {
      "import": "./dist/esm/generated/tables.js",
      "require": "./dist/umd/generated/tables.js",
      "types": "./typings/src/generated/tables.d.ts"
    },
    "./kit/specify": {
      "import": "./dist/esm/specify/index.js",
      "require": "./dist/umd/specify/index.js",
      "types": "./typings/src/kit/specify/index.d.ts"
    },
    "./kit/smartx": {
      "import": "./dist/esm/smartx/index.js",
      "require": "./dist/umd/smartx/index.js",
      "types": "./typings/src/kit/smartx/index.d.ts"
    },
    "./kit/specify/style.css": {
      "import": "./dist/kit/specify/style.css"
    },
    "./kit/smartx/style.css": {
      "import": "./dist/kit/smartx/style.css"
    },
    "./styles/reset.css": {
      "import": "./src/styles/reset.css"
    },
    "./styles/fonts/font.css": {
      "import": "./src/styles/fonts/font.css"
    }
  },
  "typesVersions": {
    "*": {
      "generated/forms-types": [
        "./typings/src/generated/forms-types.d.ts"
      ],
      "generated/forms": [
        "./typings/src/generated/forms.d.ts"
      ],
      "generated/forms2": [
        "./src/generated/forms2.tsx"
      ],
      "generated/global-search": [
        "./typings/src/generated/global-search.d.ts"
      ],
      "generated/react-hooks": [
        "./typings/src/generated/react-hooks.d.ts"
      ],
      "generated/tables": [
        "./typings/src/generated/tables.d.ts"
      ],
      "kit/specify": [
        "./typings/src/kit/specify/index.d.ts"
      ],
      "kit/smartx": [
        "./typings/src/kit/smartx/index.d.ts"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "rollup --config rollup.config.js --bundleConfigAsCjs",
    "postbuild": "cp -r src/kit/specify/images dist/images",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "pregenerate": "rm -rf src/generated",
    "generate:query": "graphql-codegen --config src/codegen/config/codegen-query.yaml",
    "generate:main": "graphql-codegen --config src/codegen/config/codegen-main.yaml",
    "generate": "yarn generate:query && yarn generate:main",
    "pretypings": "rm -rf typings",
    "typings": "yarn typings:main",
    "typings:main": "tsc -v && tsc --outDir typings --emitDeclarationOnly --skipLibCheck -p tsconfig.build.json || exit 0"
  },
  "dependencies": {
    "@linaria/core": "^4.2.2",
    "@linaria/react": "^4.3.0",
    "@tower/i18n": "^1.9.2",
    "history": "^4.9"
  },
  "devDependencies": {
    "@cloudtower/claw": "^0.6.11",
    "@graphql-codegen/cli": "^1.12",
    "@graphql-codegen/client-preset": "^1.0.6",
    "@graphql-codegen/typescript": "^1.22",
    "@graphql-codegen/typescript-operations": "^1.9",
    "@graphql-codegen/typescript-react-apollo": "^1.9",
    "@linaria/core": "^4.2.2",
    "@linaria/react": "^4.3.0",
    "@linaria/rollup": "^4.1.5",
    "@smartx/final-form": "^4.19.1-rc2",
    "@smartx/final-form-arrays": "^3.0.2-rc4",
    "@smartx/react-final-form": "^6.4.0-rc4",
    "@smartx/react-final-form-arrays": "^3.1.1-rc5",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.1.5",
    "@testing-library/react-hooks": "^8.0.1",
    "@tower/provider-interface": "^1.9.1",
    "@types/apollo-upload-client": "^8.1.3",
    "@types/history": "^4.7.11",
    "@types/react": "^17.0.50",
    "@types/react-is": "^17.0.3",
    "@types/react-transition-group": "^4.4.5",
    "@vitejs/plugin-react": "^2.1.0",
    "@vitest/coverage-c8": "^0.24.1",
    "antd": "4.5",
    "apollo-boost": "^0.4.7",
    "apollo-link-retry": "^2.2.16",
    "apollo-link-ws": "^1.0.20",
    "apollo-upload-client": "^12",
    "graphql": "^14.7.0",
    "history": "^4.9",
    "i18next": "^21.10.0",
    "is-unicode-supported": "^1.3.0",
    "jsdom": "^20.0.1",
    "react": "^17.0.2",
    "react-apollo": "^3.1",
    "react-dom": "^17.0.2",
    "react-i18next": "^11.18.6",
    "react-is": "^18.2.0",
    "react-redux": "^7.1.3",
    "react-transition-group": "^4.4.5",
    "redux": "^4.2.0",
    "rollup": "^3.2.2",
    "rollup-plugin-esbuild": "^4.10.1",
    "rollup-plugin-polyfill-node": "^0.10.2",
    "rollup-plugin-scss": "^3.0.0",
    "rollup-plugin-visualizer": "^5.8.2",
    "sass": "^1.55.0",
    "smart-cache-invalidation": "^1.2.0",
    "ts-node": "^10.9.1",
    "vite": "^3.1.7",
    "vitest": "^0.24.1"
  },
  "peerDependencies": {
    "graphql": "^14.7.0",
    "react-redux": "^7.1.3",
    "redux": "^4.2.0"
  }
}
