{
  "name": "@cloudtower/eagle",
  "version": "0.5.4",
  "main": "dist/umd/index.js",
  "module": "./dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/umd/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./generated/forms": {
      "import": "./dist/esm/generated/forms.js",
      "require": "./dist/umd/generated/forms.js",
      "types": "./dist/src/generated/forms.d.ts"
    },
    "./generated/forms2": {
      "import": "./dist/esm/generated/forms2.js",
      "require": "./dist/umd/generated/forms2.js",
      "types": "./dist/src/generated/forms2.d.ts"
    },
    "./generated/global-search": {
      "import": "./dist/esm/generated/global-search.js",
      "require": "./dist/umd/generated/global-search.js",
      "types": "./dist/src/generated/global-search.d.ts"
    },
    "./generated/react-hooks": {
      "import": "./dist/esm/generated/react-hooks.js",
      "require": "./dist/umd/generated/react-hooks.js",
      "types": "./dist/src/generated/react-hooks.d.ts"
    },
    "./generated/tables": {
      "import": "./dist/esm/generated/tables.js",
      "require": "./dist/umd/generated/tables.js",
      "types": "./dist/src/generated/tables.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "generated/forms": [
        "./dist/src/generated/forms.d.ts"
      ],
      "generated/forms2": [
        "./dist/src/generated/forms2.d.ts"
      ],
      "generated/global-search": [
        "./dist/src/generated/global-search.d.ts"
      ],
      "generated/react-hooks": [
        "./dist/src/generated/react-hooks.d.ts"
      ],
      "generated/tables": [
        "./dist/src/generated/tables.d.ts"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "rollup --config rollup.config.js --bundleConfigAsCjs",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "pregenerate": "rm -rf src/generated",
    "generate": "graphql-codegen --config src/codegen/config/codegen-main.yaml",
    "typings": "tsc -v && tsc --emitDeclarationOnly --skipLibCheck -p tsconfig.build.json || exit 0"
  },
  "dependencies": {
    "@cloudtower/sparrow": "^0.5.3",
    "@linaria/core": "^4.1.4",
    "@tower/i18n": "^1.9.2",
    "history": "^4"
  },
  "devDependencies": {
    "@cloudtower/claw": "^0.5.0",
    "@graphql-codegen/cli": "^1.12",
    "@graphql-codegen/client-preset": "^1.0.6",
    "@graphql-codegen/typescript": "^1.22",
    "@graphql-codegen/typescript-operations": "^1.9",
    "@graphql-codegen/typescript-react-apollo": "^1.9",
    "@linaria/rollup": "^4.1.5",
    "@smartx/final-form-arrays": "^3.0.2-rc4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.1.5",
    "@tower/provider-interface": "^1.9.1",
    "@types/react": "^17.0.50",
    "@types/react-transition-group": "^4.4.5",
    "@vitejs/plugin-react": "^2.1.0",
    "@vitest/coverage-c8": "^0.24.1",
    "antd": "4.5",
    "graphql": "^15.7.2",
    "i18next": "^21.10.0",
    "is-unicode-supported": "^1.3.0",
    "jsdom": "^20.0.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-i18next": "^11.18.6",
    "react-redux": "^7.1.3",
    "react-transition-group": "^4.4.5",
    "redux": "^4.2.0",
    "rollup": "^3.2.2",
    "rollup-plugin-esbuild": "^4.10.1",
    "rollup-plugin-polyfill-node": "^0.10.2",
    "rollup-plugin-scss": "^3.0.0",
    "rollup-plugin-visualizer": "^5.8.2",
    "sass": "^1.55.0",
    "ts-node": "^10.9.1",
    "vite": "^3.1.7",
    "vitest": "^0.24.1"
  },
  "peerDependencies": {
    "graphql": "^15.7.2",
    "react-redux": "^7.1.3",
    "redux": "^4.2.0"
  }
}
