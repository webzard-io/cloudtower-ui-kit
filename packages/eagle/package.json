{
  "name": "@cloudtower/eagle",
  "version": "0.25.16",
  "main": "dist/umd/index.js",
  "module": "./dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "antd"
  ],
  "license": "MIT",
  "homepage": "https://github.com/webzard-io/cloudtower-ui-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/webzard-io/cloudtower-ui-kit.git"
  },
  "scripts": {
    "build": "rollup --config rollup.config.js --bundleConfigAsCjs",
    "copyStyle": "yarn copyStyleIndex && yarn copyESStyle && yarn copyLibStyle",
    "copyStyleIndex": "mkdir -p antd/dist && cp ../../node_modules/antd/dist/antd.less antd/dist/antd.less",
    "copyESStyle": "rsync -av --include='antd/' --include='antd/es/' --include='antd/es/**/' --include='antd/es/**/style' --include='antd/es/**/style/*' --exclude '*' ../../node_modules/antd ./",
    "copyLibStyle": "rsync -av --include='antd/' --include='antd/lib/' --include='antd/lib/**/' --include='antd/lib/style/*' --include='antd/lib/style/**' --include='antd/lib/**/style' --include='antd/lib/**/style/*' --exclude '*' ../../node_modules/antd ./",
    "copyVariables": "cp src/styles/common/variables.scss dist/variables.scss",
    "postbuild": "yarn copyVariables && yarn copyStyle",
    "test": "vitest",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
    "typings": "tsc -v && tsc --emitDeclarationOnly --paths null",
    "generate:images": "node --loader ts-node/esm tools/index.mts",
    "prestorybook": "cd ../.. && yarn turbo run build",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook"
  },
  "dependencies": {
    "@cloudtower/icons-react": "0.25.16",
    "@cloudtower/parrot": "0.25.16",
    "@cloudtower/rc-notification": "^4.6.1",
    "@linaria/core": "^4.2.2",
    "@linaria/react": "^4.3.0",
    "antd": "4.5.0",
    "classnames": "^2.3.2",
    "react-beautiful-dnd": "^13.0.0",
    "react-i18next": "^12.1.5",
    "react-redux": "^7.1.3",
    "react-svg-unique-id": "^1.3.3",
    "recharts": "^2.1.16",
    "redux": "^4.2.0",
    "timezones.json": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@cloudtower/icons": "0.25.16",
    "@linaria/babel-preset": "4.4.1",
    "@linaria/rollup": "^4.1.5",
    "@linaria/vite": "^4.2.5",
    "@linaria/webpack-loader": "^4.1.15",
    "@rollup/plugin-image": "^3.0.2",
    "@storybook/addon-actions": "^6.5.16",
    "@storybook/addon-essentials": "^6.5.16",
    "@storybook/addon-interactions": "^6.5.16",
    "@storybook/addon-links": "^6.5.16",
    "@storybook/builder-webpack5": "^6.5.16",
    "@storybook/manager-webpack5": "^6.5.16",
    "@storybook/react": "^6.5.16",
    "@storybook/testing-library": "^0.0.13",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.1.5",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/react": "^17.0.50",
    "@types/react-beautiful-dnd": "^13.1.4",
    "@types/react-is": "^17.0.3",
    "@vitejs/plugin-react": "^2.1.0",
    "@vitest/coverage-c8": "^0.24.1",
    "babel-loader": "^8.3.0",
    "copy-to-clipboard": "^3.3.3",
    "css-loader": "^6.7.3",
    "globby": "^13.1.2",
    "jsdom": "^20.0.1",
    "less": "^4.1.3",
    "less-loader": "^11.1.0",
    "linaria": "^4.1.13",
    "mini-css-extract-plugin": "^2.7.2",
    "postcss": "^8.4.20",
    "postcss-url": "^10.1.3",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-is": "^18.2.0",
    "react-scripts": "^5.0.1",
    "readline": "^1.3.0",
    "resize-observer-polyfill": "^1.5.1",
    "rollup": "^3.12.1",
    "rollup-plugin-esbuild": "5.0.0",
    "rollup-plugin-polyfill-node": "^0.12.0",
    "rollup-plugin-scss": "^3.0.0",
    "rollup-plugin-visualizer": "5.9.0",
    "sass": "^1.55.0",
    "storybook-addon-designs": "^6.3.1",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "typescript": "5.0.2",
    "vite": "^3.1.7",
    "vitest": "^0.24.1"
  },
  "gitHead": "6c907fc1bed385f0d1a616e6d87753d91d4bb36b"
}
