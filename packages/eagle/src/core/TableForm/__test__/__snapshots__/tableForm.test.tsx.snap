    &:active,
    &:focus,
    &.ant-input-affix-wrapper-focused,
    &.__pseudo-states-active,
    &.__pseudo-states-focus {
      border-color: $blue;
      box-shadow: $shadow-light-active;
    }
  }

  &.ant-input-affix-wrapper.error:not(.ant-input-affix-wrapper-disabled) {
    border-color: $red;
