    textarea#{&}.ant-input {
      transition-property: height;
      transition-delay: 50ms;
      &.textarea-large {
        min-height: 40px;
        height: 40px;
      }
      &.textarea-large:focus {
        height: 80px;
      }
      &.textarea-middle {
