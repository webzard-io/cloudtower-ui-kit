                          class=ant-form-item-control-input-content
                        >
                          <p
                            class=
  @include Inter();
  font-size: 12px;
  line-height: 18px;
,
  color: rgba(44, 56, 82, 0.6);
  line-height: 32px;
  height: 32px;
  margin-bottom: 0;
  &.primary,
  &.info {
    color: $text-light-general;
  }
  &.warning {
    color: #ffa500;
  }
  &.success {
    color: $text-light-positive;
  }
  &.danger,
  &.error {
    color: $text-light-serious;
  }
  &.normal {
    color: $text-secondary-light;
  }

                          >
                            批量填充
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
