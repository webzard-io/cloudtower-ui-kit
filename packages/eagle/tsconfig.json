{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es6",
    "module": "es6",
    "outDir": "./dist",
    "jsx": "react",
    "downlevelIteration": true,
    "disableSizeLimit": true,
    "paths": {
      "@src/*": ["./src/*"],
      "@stories/*": ["./stories/*"]
    }
  },
  "include": ["src", "images.d.ts", "stories"],
  "exclude": ["node_modules"]
}
