{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "outDir": "./dist",
    "jsx": "react",
    "downlevelIteration": true,
    "disableSizeLimit": true,
    "baseUrl": "./",
    "paths": {
      "@cloudtower/eagle/generated/*": ["./src/generated/*"],
      "@cloudtower/eagle/kit/*": ["./src/kit/*"],
      "@cloudtower/parrot": ["../parrot/src/index.ts"]
    }
  },
  "include": ["src", "images.d.ts"],
  "exclude": ["node_modules"]
}
