import { ReactNode, ReactElement } from "react";
import { ColProps } from "antd/lib/col";
import { FormApi, FieldState } from "@smartx/final-form";
import {
  FormProps,
  FormRenderProps,
  FieldMetaState,
  FieldRenderProps,
  UseFieldConfig
} from "@smartx/react-final-form";
import {
  UseFieldArrayConfig,
  FieldArrayRenderProps
} from "@smartx/react-final-form-arrays";

export type FormItemProps = {
  autoFocus?: boolean;
  className: string;
  children: ReactNode;
};

export type FormLayout = "general" | "compact"
export type LabelAlign = "left" | "right"
export type LayoutProps = {
  layout?: FormLayout;
  labelCol?: ColProps;
  wrapperCol?: ColProps;
  labelAlign?: LabelAlign;
}

export type ValuesFactory<Values> = (prevValues: Readonly<Values>) => Values;
export type SetValues<Values> = (callback: ValuesFactory<Values>) => void;
export type UseFormApi<Values> = FormApi<Values> & {
  setValues: SetValues<Values>;
}

export type BaseFieldBaseFnProps<T, RP, FormValue> = {
  value: T;
  meta: FieldMetaState<T>;
  values?: FormValue;
} & RP;

export type BaseFieldBaseFn<T, RP, FormValue> = (
  props: BaseFieldBaseFnProps<T, RP, FormValue>
) => ReactNode;

export type BaseFieldChildrenFnProps<T, RP, FormValue> = RP &
  FieldRenderProps<T> & { values?: FormValue };

export type BaseFieldChildrenFn<T, RP, FormValue> = (
  props: BaseFieldChildrenFnProps<T, RP, FormValue>
) => ReactNode;

export type BaseFieldRenderFnProps<T, RP, FormValue> = BaseFieldChildrenFnProps<
  T,
  RP,
  FormValue
> & { children?: ReactNode };

export type BaseFieldRenderFn<T, RP, FormValue> = (
  props: BaseFieldRenderFnProps<T, RP, FormValue>
) => ReactNode;

export type OnChangeFn<T, FormValue> = (param: {
  value: T;
  previousValue?: T;
  allValues: FormValue;
  initialValues?: FormValue;
  setValues: SetValues<FormValue>;
  formApi: UseFormApi<FormValue>;
  name: string;
}) => void;

export type BaseProps<T, RP, FormValue, Err = string> = {
  name?: string;
  label?: BaseFieldBaseFn<T, RP, FormValue> | ReactNode;
  error?: BaseFieldBaseFn<T, RP, FormValue> | ReactNode;
  extra?: BaseFieldBaseFn<T, RP, FormValue> | ReactNode;
  render?: BaseFieldRenderFn<T, RP, FormValue>;
  children?: BaseFieldChildrenFn<T, RP, FormValue> | ReactNode;
  showError?: boolean;

  if?: boolean | ((values: FormValue) => boolean);
  spyValues?: boolean;
  validate?: (props: {
    value: T;
    previousValue?: T;
    allValues: FormValue;
    meta: FieldState<T>;
  }) => Err | Promise<Err | undefined | void> | undefined | void;
  recoverOnBlur?: boolean;

  className?: string;
  layoutProps?: LayoutProps;
  autoFocus?: boolean;
};

export type BaseFieldProps<T, RP, FormValue, Err = string> = BaseProps<T, RP, FormValue, Err> &
  Omit<UseFieldConfig<T>, "validate"> &
  RP;
export type BaseFieldPropsWithName<T, RP, FormValue, Err = string> = BaseFieldProps<T, RP, FormValue, Err> & {
  name: string;
  onChange?: OnChangeFn<T, FormValue>;
};

export type BaseFieldArrayFnProps<T, RP, FormValue> = RP &
  FieldArrayRenderProps<T, HTMLElement> & { values?: FormValue };

export type BaseFieldArrayFn<T, RP, FormValue> = (
  props: BaseFieldArrayFnProps<T, RP, FormValue>
) => ReactNode;

export type BaseFieldArrayBaseProps<T, RP, FormValue, Err = string> = {
  name?: string;
  label?: BaseFieldArrayFn<T, RP, FormValue> | ReactNode;
  error?: BaseFieldArrayFn<T, RP, FormValue> | ReactNode;
  extra?: BaseFieldArrayFn<T, RP, FormValue> | ReactNode;
  children: BaseFieldArrayFn<T, RP, FormValue>;
  showError?: boolean;
  render?: undefined;

  if?: boolean | ((values: FormValue) => boolean);
  spyValues?: boolean;
  validate?: (props: {
    value: T[];
    previousValue?: T[];
    allValues: FormValue;
    meta: FieldState<T[]>;
  }) => Err | Promise<Err | undefined | void> | undefined | void;

  className?: string;
  layoutProps?: LayoutProps;
  autoFocus?: boolean;
};

export type BaseFieldArrayProps<T, RP, FormValue, Err = string> = RP &
  Omit<UseFieldArrayConfig<T>, "validate"> &
  BaseFieldArrayBaseProps<T, RP, FormValue, Err>;

export type BaseFieldArrayPropsWithName<T, RP, FormValue, Err = string> = BaseFieldArrayProps<T, RP, FormValue, Err> & {
  name: string;
  onChange?: OnChangeFn<T[], FormValue>;
};

export type BaseFormProps<T, Err, F = {}, OnChange = {}> = Omit<FormProps<T>, "onSubmit" | "children"> & {
  onSubmit: (values: T, form: FormApi<T>, callback?: (errors?: Err) => void) =>
    Err | Promise<Err | undefined | void> | undefined | void;
  children: (
    props: Omit<FormRenderProps<T>, 'form'> & { fields: F } & { form: UseFormApi<T> }
  ) =>
    ReactElement;
  layoutProps?: LayoutProps;
  submitting?: boolean;
  onChange?: OnChange;
};
