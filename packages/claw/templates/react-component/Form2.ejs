export namespace <%= name %> {
  export type FormValue = <%- value %>;

  export type FieldValue = {
    <% for (c of collection) { -%>
      '<%= c.path %>': <%- c.value %>;
    <% } -%>
  }

  type FieldValidators = Partial<{
    [K in keyof FieldValue]: (
      value: FieldValue[K],
      values: FormValue,
      meta?: FieldState<FieldValue[K]>
    ) => Promise<string | undefined> | string | undefined;
  }>

  export type Validation = Partial<{
    form: (values: FormValue) => Promise<string | undefined> | string | undefined;
    field: FieldValidators;
  }>

  type FieldOnChanges = Partial<{
    [K in keyof FieldValue]: FormKit.FieldOnChange<FieldValue[K], FormValue>
  }>

  const FormContext = React.createContext<FormKit.FormContextType<FieldValidators, FieldOnChanges>>({
    layout: FormKit.DEFAULT_LAYOUT,
    kit: antdKit,
    validators: {},
    onChanges: {}
  });

  export type FormProps = FormKit.BaseFormProps<FormValue, Validation, FieldOnChanges>

  export const Form: React.FC<FormProps> = ({
    render,
    layout = {},
    initialValues,
    keepDirtyOnReinitialize,
    onSubmit: _onSubmit,
    validation = {},
    onChanges = {},
    ...rest
  }: FormKit.BaseFormProps<FormValue, Validation, FieldOnChanges>) => {
    const _initialValues = FormKit.useMemoInitialValues(
      initialValues,
      keepDirtyOnReinitialize
    );
    const {
      form: _validate,
      field: fieldValidators = {}
    } = validation;
    const validate = _validate
      ? async (values: FormValue) => {
          const result = await _validate(values)
          if (result) {
            return {
              [FORM_ERROR]: result
            }
          }
        }
      : undefined

   const stack = useKitSelector<KitRootState['modal']['stack']>(
     state => state.modal.stack
   );
   const id = useKitSelector<KitRootState['modal']['closeId']>(
     state => state.modal.closeId
   );
   const idRef = useRef(stack[stack.length - 1]?.id);

   const onSubmit = useCallback<FormProps['onSubmit']>(
     (...args) => (idRef.current === id ? undefined : _onSubmit(...args)),
     [id, _onSubmit]
   );

    return (
      <kitContext.Consumer>
        {kit => (
          <FormContext.Provider
            value={{
              layout: { ...FormKit.DEFAULT_LAYOUT, ...layout },
              kit,
              validators: fieldValidators,
              onChanges,
            }}>
            <ReactFinalForm<FormValue>
              mutators={{ ...FormKit.arrayMutators, setValues: FormKit.setValuesMutator }}
              subscription={{ values: true }}
              initialValues={_initialValues}
              keepDirtyOnReinitialize={keepDirtyOnReinitialize}
              onSubmit={onSubmit}
              validateOnBlur
              validate={validate}
              {...rest}
            >
              {({handleSubmit, ...props}) => {
                FormKit.useEnterToSubmit(handleSubmit);
                const form = {
                  ...props.form,
                  setValues: props.form.mutators.setValues
                } as FormKit.UseFormApi<FormValue>;
                return render({ ...props, form, handleSubmit });
              }}
            </ReactFinalForm>
          </FormContext.Provider>
        )}
      </kitContext.Consumer>
    );
  }

  export const FormSpy: FormKit.FormSpyComponent<FormValue> = ({
    children,
    ...rest
  }) => {
    return (
      <ReactFinalFormSpy {...rest}>
        {props => {
          if (typeof children === 'function') {
            const form = props.form as FormKit.UseFormApi<FormValue>;
            form.setValues = form.mutators.setValues;
            return children({ ...props, form });
          }
          return children;
        }}
      </ReactFinalFormSpy>
    );
  };

  export class FormField {
    <%- field -%>
  }
}