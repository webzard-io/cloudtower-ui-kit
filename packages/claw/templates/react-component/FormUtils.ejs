/**
 * A simple hook to create a constant value that lives for
 * the lifetime of the component.
 *
 * source from https://github.com/Andarist/use-constant
 *
 * @param {Function} init - A function to generate the value
 */

type ResultBox<T> = { v: T }
export function useConstant<T>(fn: () => T): T {
  const ref = React.useRef<ResultBox<T>>()

  if (!ref.current) {
    ref.current = { v: fn() }
  }

  return ref.current.v
}

export type OnChangeProps<FieldValue> = {
  name: string;
  children: (value: FieldValue, previous?: FieldValue) => void;
};

export const RffOnChange = function<FieldValue, FormValue>(
  props: OnChangeProps<FieldValue>
) {
  const { name, children } = props;
  const formApi = useRffForm<FormValue>()
  const previous = useRef<FieldValue>();
  const OnChange: React.FC<{ value: FieldValue }> = ({ value }) => {
    useEffect(() => {
      let { value: _value } = formApi.getFieldState(name) || {}
      if (_value === '') {
        // In final-form, empty will be formatted to undefined
        // However, this conversion misses in initializing
        // If we init a field with empty string,
        // it triggers unexpected onChange since '' not equal to undefined.
        // So we need to convert empty string to undefined here.
        _value = undefined
      }
      if (!_.isEqual(_value, previous.current)) {
        children(_value, previous.current);
        previous.current = _value;
      }
    }, [value]);
    return null;
  };
  return (
    <Field
      name={name}
      subscription={{ value: true }}
      allowNull
      render={({ input }) => (
        <OnChange value={input.value} children={children} />
      )}
    />
  );
};

export function classifyProps<T, RP, FormValue, Err = {}>(
  props: FT.BaseFieldPropsWithName<T, RP, FormValue, Err>
): {
  baseProps: FT.BaseProps<T, RP, FormValue, Err> & { name: string,  onChange?: FT.OnChangeFn<T, FormValue>; };
  fieldProps: UseFieldConfig<T>;
  renderProps: RP;
} {
  const {
    name,
    label,
    error,
    extra,
    render,
    children,
    showError,
    layoutProps,
    className,
    autoFocus,
    if: _if,
    spyValues = false,
    onChange,
    recoverOnBlur,

    afterSubmit,
    allowNull,
    beforeSubmit,
    defaultValue,
    format,
    formatOnBlur,
    initialValue,
    isEqual,
    multiple,
    parse,
    subscription,
    type,
    validate,
    validateFields,
    value,

    ...rest
  } = props;
  return {
    baseProps: {
      name,
      label,
      error,
      extra,
      render,
      children,
      showError,
      layoutProps,
      className,
      autoFocus,
      if: _if,
      spyValues,
      onChange,
      validate,
      recoverOnBlur,
    },
    fieldProps: {
      afterSubmit,
      allowNull,
      beforeSubmit,
      defaultValue,
      format,
      formatOnBlur,
      initialValue,
      isEqual,
      multiple,
      parse,
      subscription,
      type,
      validateFields,
      value
    },
    renderProps: (rest as unknown) as RP
  };
}

