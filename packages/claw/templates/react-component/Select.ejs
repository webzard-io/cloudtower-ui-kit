import {
  <%= hook %>,
  <%= query %>,
  <%= variables %>,
  <% if (enableCreate && isAsyncResource) { %>
    <%= document %>,
  <% } %>
} from "@cloudtower/eagle/generated/react-hooks";

export type <%= selectName %>Props = {
  allowAll?: boolean;
  allText?: string;
  lazy?: boolean;
  renderOptions?: (data: <%= query %>) => React.ReactElement[];
  renderOptionItem?: (data: <%= query %>['<%= pluralized %>'][0]) => React.ReactElement;
  variables?: Omit<<%= variables %>, 'skipExtra'> & {
    skipExtra?: boolean;
  }
  onCompleted?: (data: <%= query %>) => unknown;
  prefixOptions?: React.ReactElement[];
  loadMore?: boolean;
  defaultSelectFirst?: boolean;
  searchable?: boolean;
  inputField?: string | string[];
  defaultSelectId?: string;
  fetchPolicy?: WatchQueryFetchPolicy;
  <% if (enableCreate) { %>
    onResourceCreate: (
      name: string
    ) => Promise<{ data?: <%= query %>['<%= pluralized %>'][0]; error?: string }>;
    onResourceCreated: (
      data?: <%= query %>['<%= pluralized %>'][0]
    ) => void;
  <% } %>
} & Omit<KitSelectProps, 'value' | 'onChange' | 'mode' | 'input' <% if (enableCreate) { %> | 'dropdownRender' <% } %>>;

export function <%= selectName %>(props: React.PropsWithChildren<SingleSelectProps<<%= query %>['<%= pluralized %>'][0]> & <%= selectName %>Props>): JSX.Element
export function <%= selectName %>(props: React.PropsWithChildren<MultipleSelectProps<<%= query %>['<%= pluralized %>'][0]> & <%= selectName %>Props>): JSX.Element
export function <%= selectName %>(props: React.PropsWithChildren<SelectProps<<%= query %>['<%= pluralized %>'][0]> & <%= selectName %>Props>): JSX.Element {
  const kit = useContext(kitContext);
  const {
    value,
    onChange,
    allowAll = false,
    allText,
    lazy = false,
    renderOptions,
    renderOptionItem,
    variables,
    onCompleted,
    mode,
    prefixOptions,
    loadMore = true,
    defaultSelectFirst,
    onSearch,
    searchable = true,
    inputField = "<%= inputField %>",
    defaultSelectId: defaultSelectIdFromProps,
    notFoundContent = 'no data',
    placeholder = '',
    onBlur,
    fetchPolicy,
    <% if (enableCreate) { %>
      onResourceCreate,
      onResourceCreated,
      dropdownClassName,
    <% } %>
    ...restProps
  } = props;
  const [name, setName] = useState('');
  const isMultiple = mode === 'multiple';
  const inputFields =
    typeof inputField === 'string' ? [inputField] : inputField;
  const selectIds = useRef(typeof value === 'string' ? [value] : value);
  
  let defaultSelectIdRef ='';
  if(defaultSelectIdFromProps){
    defaultSelectIdRef = defaultSelectIdFromProps;
  }else{
    defaultSelectIdRef = typeof value === 'string' ? (value as string) : '';
  }
  const defaultSelectId = useRef(defaultSelectIdRef).current;

  const [
    trigger,
    { loading, error, data, fetchMore, refetch }
  ] = <%= hook %>({
    variables: {
      first: 20,
      ...variables,
      where: {
        ...variables?.where,
        OR: inputFields.map(path => _.set({}, path, name)),
      },
      skipExtra: true,
    },
    fetchPolicy: fetchPolicy || 'cache-and-network'
  });

  useEffect(() => {
    if (
      (!lazy && !data) ||
      (isMultiple && !_.isEqual(selectIds.current, value))
    ) {
      if (isMultiple) {
        selectIds.current = value as string[];
      }
      trigger({
        variables: {
          skipExtra: !isMultiple && !defaultSelectId,
          extraIds: typeof value === 'string' ? [defaultSelectId] : value || [],
        },
      });
    }
  }, [trigger, lazy, value, data, isMultiple, defaultSelectId]);

  const firstQuery = useRef(true);

  const extraData = data?.extra?.filter(
    e => !data.<%= pluralized %>.find(d => d.id === e.id)
  ) || [];

  useEffect(() => {
    canFetchMore.current = true;
    if (!firstQuery.current || !data) return;

    onCompleted?.(data);
    if (defaultSelectFirst && !lazy && data.<%= pluralized %>.length) {
      const val =
        mode === 'multiple' ? [data.<%= pluralized %>[0].id] : data.<%= pluralized %>[0].id;
        onChange(
          val as string & string[],
          data.<%= pluralized %>[0],
          data.<%= pluralized %>.concat(extraData)
        );
    }
    firstQuery.current = false;
  }, [data, defaultSelectFirst, lazy, mode, onChange, onCompleted]);

  const canFetchMore = useRef(true);
  const [fetching, setFetching] = useState(false);

  const isFirstLoading = useMemo(
    () => {
      return !lazy && !data && (firstQuery.current || loading)
    },
    [lazy, firstQuery, data, loading],
  );

  <% if (enableCreate) { %>
    const [creating, setCreating] = useState(false);
  <% } %>

  return (
    <kit.select
      loading={loading}
      disabled={isFirstLoading}
      placeholder={loading ? parrotI18n.t('common.current_loading_with_dot') : placeholder}
      error={error && <FailedLoad error={error} refetch={refetch} />}
      onDropdownVisibleChange={open => {
        if (open && lazy && !data) {
          trigger({
            variables: {
              skipExtra: !isMultiple && !defaultSelectId,
              extraIds: typeof value === 'string' ? [defaultSelectId] : value,
            },
          });
        }
      }}
      input={
        isFirstLoading?
        { value: undefined }:
        {
          value,
          onChange: (value, option) => {
            let selected = (option as { object: any }).object;
            if (isMultiple) {
              selectIds.current = value as string[];
              selected = (option as Array<{ object: any }>).map(
                opt => opt.object
              );
            }
            onChange(
              value as string & string[],
              selected,
              data?.<%= pluralized %>?.concat(extraData)
            );
            searchable && setTimeout(()=>setName(''),0);
          },
        }
    }
      multiple={mode === 'multiple'}
      onScrollBottom={() => {
        if (loadMore && canFetchMore.current && !fetching) {
          setFetching(true);
          fetchMore({
            variables: {
              skip: data?.<%= pluralized %>.length,
            },
            updateQuery: (prev, { fetchMoreResult }) => {
              const length = fetchMoreResult?.<%= pluralized %>.length || 0;
              const first = variables?.first || 20;
              setFetching(false);

              if (!length || first > length) {
                canFetchMore.current = false;
              }
              if (!length) return prev;
              return {
                <%= pluralized %>: [...prev.<%= pluralized %>, ...fetchMoreResult!.<%= pluralized %>],
                extra: fetchMoreResult?.extra || [],
              };
            },
          });
       }
     }}
     onSearch={
       searchable
         ? value => {
            setName(value);
            onSearch?.(value);
          }
        : undefined
     }
     onBlur={(e) => {
       searchable && setName('');
       onBlur?.(e)
     }}
     filterOption={isMultiple ? () => true : undefined}
     notFoundContent={notFoundContent}
     <% if (enableCreate) { %>
      dropdownClassName={cs(
        dropdownClassName,
        creating && CreatingSelectDropdownStyle
      )}
      dropdownRender={menu => {
        return (<div>
          {menu}
          <CreateResourceDropdownRender<<%= query %>['<%= pluralized %>'][0]>
            onCreate={onResourceCreate}
            <% if (enableCreate && isAsyncResource) { %>
              isAsync={<%= isAsyncResource %>}
            <% } %>
            onCreatingChange={(creating, data) => {
              setCreating(creating);
              if (!creating && data && typeof onResourceCreated === 'function') onResourceCreated(data);
            }}
            placeholder={parrotI18n.t('common.create_<%= type %>')}
          />
        </div>);
      }}
     <% } %>
     onInputKeyDown={e => {
      e.stopPropagation();
     }}
     {...restProps}>
      {allowAll && !name && Boolean(data?.<%= pluralized %>.length) && <kit.option value="">{allText || parrotI18n.t('common.all')}</kit.option>}
      {prefixOptions}
      {data &&
        (renderOptions
          ? renderOptions(data)
          : data.<%= pluralized %>.map(<%= base %> => {
              return renderOptionItem?.(<%= base %>) ?? (
                <kit.option key={<%= base %>.id} value={<%= base %>.id} object={<%= base %>}>
                  {<%= base %>[<%- dataIndex %>]}
                </kit.option>
              )
            }))}
      {fetching && (
        <kit.option
          className="fetching-more"
          disabled
          key="....fetching-more...."
          value="....fetching-more....">
          {parrotI18n.t('common.fetching-more')}
        </kit.option>
      )}
      {!data?.<%= pluralized %>.length && extraData.length > 0 && (
        <kit.option
          className="select-content-empty"
          disabled
          key="....select-content-empty...."
          value="....select-content-empty....">
          {notFoundContent}
        </kit.option>
      )}
      {extraData.map(<%= base %> => {
        if (renderOptionItem) {
          const extraOptionElement = renderOptionItem(<%= base %>);
          return React.cloneElement(
            extraOptionElement,
            {
              className: cs('display-none', extraOptionElement.props.className),
              key: extraOptionElement?.props.key?.startsWith('___')
                    ? extraOptionElement?.props.key
                    : `___${<%= base %>.id}`,
            }
          );
        }
        return (
          <kit.option
            className="display-none"
            key={`___${<%= base %>.id}`}
            value={<%= base %>.id}>
            {<%= base %>[<%- dataIndex %>]}
          </kit.option>
        )
      })}
    </kit.select>
  );
};
