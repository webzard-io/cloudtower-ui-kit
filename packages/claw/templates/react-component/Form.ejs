/* <%= name.form %> */
/* Base Fields */
export const <%= name.baseFields %>: <%= type.baseFields %> = {
  <% for (field of baseFields) { -%>
    '<%= field.key %>'(props) {
      <% if (!field.isObject) { %>
      const kit = useContext(kitContext);
      <% } %>
      const { onChangeMap } = useContext(<%= name.baseFormContext %>);
      return (
        <BaseField<<%= type.baseFieldKeys %>['<%= field.key %>'], typeof props, <%= type.formValue %>>
          name='<%= field.key %>'

          <% if (!field.isObject) { %>
            <% switch (field.scalarType) {
              case "Boolean": -%>
                render={kit.fields.Boolean}
              <% break; -%>
              <% case "Int": -%>
                render={kit.fields.Int}
              <% break; -%>
              <% case "Float": -%>
                render={kit.fields.Float}
              <% break; -%>
              <% default: -%>
                render={kit.fields.String}
              <% break; -%>
            <% } -%>
          <% } %>
          {...props}
          onChange={onChangeMap?.['<%= field.key %>']}
        />
      );
    },
  <% } -%>
}

/* Base Field Arrays */
export const <%= name.baseFieldArrays %>: <%= type.baseFieldArrays %> = {
  <% for (field of baseFieldArrays) { -%>
    '<%= field.key %>'(props) {
      const { onChangeMap } = useContext(<%= name.baseFormContext %>);
      return (
        <BaseFieldArray<<%= type.baseFieldArrayKeys %>['<%= field.key %>'], typeof props, <%= type.formValue %>>
          name='<%= field.key %>'
          {...props}
          onChange={onChangeMap?.['<%= field.key %>']}>
          {(renderProps: any) =>
            props.children({
              ...renderProps,
              childFields: {
                <% for (baseField of baseFields) { -%>
                  <% if (baseField.key.startsWith(field.key + '.')) { %>
                    '<%= baseField.key.substring(field.key.length + 1) %>': <%= name.baseFields %>['<%= baseField.key %>'],
                  <% } -%>
                <% } -%>
                <% for (baseFieldArray of baseFieldArrays) { -%>
                  <% if (baseFieldArray.key.startsWith(field.key + '.')) { %>
                    '<%= baseFieldArray.key.substring(field.key.length + 1) %>': <%= name.baseFieldArrays %>['<%= baseFieldArray.key %>'],
                  <% } -%>
                <% } -%>
              },
            })
          }
        </BaseFieldArray>
      )
    },
  <% } -%>
}

/* Base Form */
const <%= name.baseFormContext %> = React.createContext<{
  onChangeMap?: <%= type.baseFormOnChange %>
}>({});

export const <%= name.baseForm %>: React.FC<<%= type.baseFormProps %>> = ({
  children,
  layoutProps = {},
  initialValues,
  keepDirtyOnReinitialize,
  onSubmit: _onSubmit,
  mutators,
  onChange,
  ...rest
}) => {
  const _initialValues = FormKit.useMemoInitialValues(
    initialValues,
    keepDirtyOnReinitialize
  );
  const onSubmit = FormKit.usePreventSubmitOnModalClose<<%= type.formValue %>>(_onSubmit)
  const onChangeMap = useConstant<<%= type.baseFormOnChange %>>(() => {
    return onChange || {}
  })
  return (
    <Form<<%= type.formValue %>>
      mutators={{ ...mutators, ...arrayMutators, setValues: FormKit.setValuesMutator }}
      subscription={{}}
      initialValues={_initialValues}
      keepDirtyOnReinitialize={keepDirtyOnReinitialize}
      onSubmit={onSubmit}
      validateOnBlur
      {...rest}
    >
      {({handleSubmit, ...props}) => {
        FormKit.useEnterToSubmit(handleSubmit)
        const form = props.form as FT.UseFormApi<<%= type.formValue %>>;
        form.setValues = form.mutators.setValues;
        return (
          <<%= name.baseFormContext %>.Provider
            value={{ onChangeMap }}
          >
            <FormLayoutContext.Provider
              value={{ ...DEFAULT_LAYOUT, ...layoutProps }}
            >
              {children({
                ...props,
                form,
                handleSubmit,
                fields: {
                  ...(<%= name.baseFields %>),
                  ...(<%= name.baseFieldArrays %>)
                },
              })}
            </FormLayoutContext.Provider>
          </<%= name.baseFormContext %>.Provider>
        )
      }}
    </Form>
  );
};

/* Hooks */
// Only use in <%= name.form %>
export const <%= name.useField %> = <
  T extends
    | <%= type.baseFieldKeys %>[keyof <%= type.baseFieldKeys %>]
    | <%= type.baseFieldArrayKeys %>[keyof <%= type.baseFieldArrayKeys %>]
    | <%= type.baseFieldArrayKeys %>[keyof <%= type.baseFieldArrayKeys %>][]
>(
  name: string,
  config?: UseFieldConfig<T>
): FieldRenderProps<T> => useField<T>(name, { ...config, isEqual: _.isEqual });

export const <%= name.useFieldValue %> = <
  T extends
    | <%= type.baseFieldKeys %>[keyof <%= type.baseFieldKeys %>]
    | <%= type.baseFieldArrayKeys %>[keyof <%= type.baseFieldArrayKeys %>]
    | <%= type.baseFieldArrayKeys %>[keyof <%= type.baseFieldArrayKeys %>][]
>(
  name: string,
  config?: UseFieldConfig<T>
): T => {
  const value = useRef<T>();
  const { input } = (<%= name.useField %>)<T>(name, config);
  if (!_.isEqual(value.current, input.value)) {
    value.current = input.value
  }
  return value.current || input.value;
}

export const <%= name.useFieldArray %> = <
  T extends <%= type.baseFieldArrayKeys %>[keyof <%= type.baseFieldArrayKeys %>],
  K extends HTMLElement = HTMLElement
>(
  name: string,
  config?: UseFieldArrayConfig<T>
): FieldArrayRenderProps<T, K> => useFieldArray<T, K>(name, { ...config, isEqual: _.isEqual });

export namespace <%= name.rawName %> {
  export type FormValue = <%= type.formValue %>;
  export type Validators = <%= type.validators %>;
  export type OnChanges = <%= type.baseFormOnChange %>;
  export type BaseFieldKeys = <%= type.baseFieldKeys %>;
  export type BaseFieldArrayKeys = <%= type.baseFieldArrayKeys %>;
  export const Fields = <%= name.baseFields %>;
  export const FieldArrays = <%= name.baseFieldArrays %>;
  export const Form = <%= name.baseForm %>;
  export const FormSpy: FormKit.FormSpyComponent<FormValue> = ({ children, ...rest }) => (
    <RffFormSpy {...rest}>
      {props => {
        if (typeof children === 'function') {
          const form = props.form as FT.UseFormApi<FormValue>;
          form.setValues = form.mutators.setValues;
          return children({ ...props, form });
        }
        return children;
      }}
    </RffFormSpy>
  );
  export const useForm = (): FT.UseFormApi<FormValue> => {
    const form = useRffForm() as any;
    form.setValues = form.mutators.setValues;
    return form;
  }
  export const useFormState: UseFormStateFn<FormValue> = params => useRffFormState(params as any);

}
